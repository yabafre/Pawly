# ─── API Configuration (apps/api) ───────────────────────────────

# Node environment
NODE_ENV=development

# Port for the NestJS API server
API_PORT=3001

# Database Connection (Neon.com PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/pawly

# JWT Authentication
# Secret key used to sign JWT tokens. Must be at least 32 characters.
# Generate with: openssl rand -base64 64
JWT_SECRET=your-jwt-secret-at-least-32-characters-long

# Email (Resend)
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
WEB_APP_URL=http://localhost:3000
MAIL_FROM=Pawly <noreply@pawly.app>

# Stripe
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# Webhook signing secret from Stripe Dashboard or CLI (`stripe listen`)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ─── Web Configuration (apps/web) ──────────────────────────────

# NestJS API URL (must match PORT above)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Stripe Price IDs for subscription plans
# Get from https://dashboard.stripe.com/prices
# MIGRATION (Story 4-2): Replaced single NEXT_PUBLIC_STRIPE_PRICE_ID with per-plan variables below
NEXT_PUBLIC_STRIPE_PRICE_STARTER=price_xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PRICE_PROFESSIONAL=price_xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE=price_xxxxxxxxxxxx

# Public base URL for SEO (sitemap, OG tags, canonical URLs)
NEXT_PUBLIC_APP_URL=https://pawly.com

# ─── Web Push (VAPID) ────────────────────────────────────────────
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:contact@pawly.app
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# ─── Observability (SigNoz — self-hosted) ────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=pawly-api
# Set to 'true' if SigNoz uses a self-signed certificate
OTEL_INSECURE_SKIP_VERIFY=false

# ─── Background Jobs (Trigger.dev — self-hosted) ─────────────────
TRIGGER_SECRET_KEY=tr_dev_xxxxxxxxxx
TRIGGER_API_URL=http://localhost:8080
