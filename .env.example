# Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/pawly

# Authentification (JWT)
# Secret key used to sign access tokens. Keep this strong and secret.
# You can generate one using: openssl rand -base64 32
JWT_SECRET=super-secret-key

# Secret key used to sign refresh tokens. Should be different from JWT_SECRET.
# You can generate one using: openssl rand -base64 32
JWT_REFRESH_SECRET=another-super-secret-key


RESEND_API_KEY=
WEB_APP_URL=http://localhost:3000
MAIL_FROM=Pawly <noreply@pawly.app>

# Environment Variables for apps/web

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001

# Note: This is the URL where the NestJS API is running
# In production, this would be your deployed API URL

# Multi-tenant clinic context (required for auth)
NEXT_PUBLIC_CLINIC_ID=
