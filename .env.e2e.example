# Copy to .env.e2e and fill DATABASE_URL. That file is gitignored because the
# connection string is a real credential.
#
# DATABASE_URL must name a SCHEMA OF ITS OWN — append `&schema=pawly_e2e` to the
# normal connection string. The suites create and truncate tables inside that
# schema; `public`, where the real data lives, is never touched, and the guard
# in apps/api/test/setup-after-env.ts refuses to run without it.
NODE_ENV=test
API_PORT=3011
DATABASE_URL=postgresql://user:password@host/pawly_e2e?sslmode=require
JWT_SECRET=e2e-test-jwt-secret-not-used-anywhere-else-0123456789
WEB_APP_URL=http://localhost:3030
NEXT_PUBLIC_API_URL=http://localhost:3011

# Resend is never reached: MailService is replaced by the capture stub, and this
# key could not authenticate anyway, so no mail leaves.
RESEND_API_KEY=re_e2e_not_a_real_key
MAIL_FROM=Pawly E2E <noreply@e2e.invalid>

# Stripe: format-valid dummies. Webhook tests sign their own payloads with this
# secret, so no call ever reaches Stripe.
STRIPE_SECRET_KEY=sk_test_e2e_dummy
STRIPE_WEBHOOK_SECRET=whsec_e2e_dummy_secret

# Cloudflare Turnstile "always passes" test pair (public, documented by CF).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# No Trigger.dev key: MailService stays on the direct path the stub captures.
CRON_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
