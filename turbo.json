{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "envMode": "loose",
    "tasks": {
        "db:generate": {
            "cache": false
        },
        "build": {
            "inputs": [
                "$TURBO_DEFAULT$",
                ".env.development.local",
                ".env.local",
                ".env.development",
                ".env"
            ],
            "dependsOn": [
                "^build",
                "db:generate"
            ],
            "outputs": [
                "dist/**",
                ".next/**",
                "!.next/cache/**"
            ],
            "env": [
                "OTEL_EXPORTER_OTLP_ENDPOINT",
                "OTEL_SERVICE_NAME",
                "OTEL_SERVICE_NAME_FRONT"
            ]
        },
        "start": {
            "inputs": [
                "$TURBO_DEFAULT$",
                ".env.development.local",
                ".env.local",
                ".env.development",
                ".env"
            ],
            "cache": false,
            "persistent": true
        },
        "dev": {
            "inputs": [
                "$TURBO_DEFAULT$",
                ".env.development.local",
                ".env.local",
                ".env.development",
                ".env"
            ],
            "cache": false,
            "persistent": true,
            "env": [
                "OTEL_EXPORTER_OTLP_ENDPOINT",
                "OTEL_SERVICE_NAME",
                "OTEL_SERVICE_NAME_FRONT"
            ]
        },
        "lint": {
            "dependsOn": [
                "^lint"
            ]
        },
        "test": {
            "dependsOn": [
                "^build"
            ],
            "cache": false
        },
        "test:cov": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "coverage/**"
            ]
        },
        "typecheck": {
            "dependsOn": [
                "^typecheck"
            ]
        },
        "trigger:dev": {
            "cache": false,
            "persistent": true,
            "env": [
                "TRIGGER_SECRET_KEY",
                "TRIGGER_API_URL",
                "DATABASE_URL",
                "RESEND_API_KEY",
                "VAPID_PUBLIC_KEY",
                "VAPID_PRIVATE_KEY",
                "VAPID_SUBJECT"
            ]
        }
    }
}