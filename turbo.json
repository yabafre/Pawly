{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "envMode": "loose",
    "tasks": {
        "build": {
            "inputs": [
                "$TURBO_DEFAULT$",
                ".env.development.local",
                ".env.local",
                ".env.development",
                ".env"
            ],
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**",
                ".next/**",
                "!.next/cache/**"
            ]
        },
        "start": {
            "inputs": [
                "$TURBO_DEFAULT$",
                ".env.development.local",
                ".env.local",
                ".env.development",
                ".env"
            ],
            "cache": false,
            "persistent": true
        },
        "dev": {
            "inputs": [
                "$TURBO_DEFAULT$",
                ".env.development.local",
                ".env.local",
                ".env.development",
                ".env"
            ],
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": [
                "^lint"
            ]
        },
        "test": {
            "dependsOn": [
                "^build"
            ],
            "cache": false
        },
        "test:cov": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "coverage/**"
            ]
        },
        "typecheck": {
            "dependsOn": [
                "^typecheck"
            ]
        }
    }
}