{
  "name": "pawly-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -- turbo run dev",
    "dev:full": "dotenv -- turbo run dev trigger:dev",
    "build": "NODE_ENV=production dotenv -- turbo run build",
    "preview": "pnpm build && pnpm prod",
    "prod": "NODE_ENV=production dotenv -- turbo run prod",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "dotenv -- pnpm --filter @pawly/api db:generate",
    "db:push": "dotenv -- pnpm --filter @pawly/api db:push",
    "db:push:force": "dotenv -- pnpm --filter @pawly/api db:push:force",
    "db:migrate:dev": "dotenv -- pnpm --filter @pawly/api db:migrate:dev",
    "db:migrate:deploy": "dotenv -- pnpm --filter @pawly/api db:migrate:deploy",
    "db:studio": "dotenv -- pnpm --filter @pawly/api db:studio",
    "db:seed": "dotenv -- pnpm --filter @pawly/api db:seed",
    "test": "dotenv -- turbo run test",
    "trigger:dev": "dotenv -- pnpm --filter @pawly/api trigger:dev",
    "trigger:deploy:staging": "dotenv -- pnpm --filter @pawly/api trigger:deploy:staging",
    "trigger:deploy:prod": "dotenv -- pnpm --filter @pawly/api trigger:deploy:prod"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prettier": "^3.4.2",
    "sharp": "^0.34.5",
    "turbo": "^2.9.18"
  },
  "pnpm": {
    "overrides": {
      "@types/qs": "6.15.1",
      "c12>pkg-types": "1.3.1",
      "handlebars": ">=4.7.8-fix",
      "hono": ">=4.7.6",
      "@hono/node-server": ">=1.14.1",
      "tar": ">=6.2.1",
      "undici": ">=6.21.1",
      "flatted": ">=3.3.3",
      "socket.io": ">=4.8.1"
    }
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}